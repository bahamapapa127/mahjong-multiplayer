{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(pnpx:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(corepack:*)",
      "Bash(turbo:*)",
      "Bash(vitest:*)",
      "Bash(biome:*)",
      "Bash(tsc:*)",
      "Bash(tsx:*)",
      "Bash(lefthook:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push)",
      "Bash(git push origin:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(where:*)",
      "Bash(which:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(diff:*)",
      "Bash(pwd:*)",
      "Bash(date:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git config --get:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(**)",
      "Write(**)",
      "ToolSearch",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ],
    "ask": [
      "Edit(/.github/**)",
      "Write(/.github/**)",
      "MultiEdit(/.github/**)",
      "Edit(/.claude/settings.json)",
      "Write(/.claude/settings.json)",
      "MultiEdit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Write(/.claude/settings.local.json)",
      "MultiEdit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Write(/.claude/hooks/**)",
      "MultiEdit(/.claude/hooks/**)",
      "Edit(/lefthook.yml)",
      "Write(/lefthook.yml)",
      "MultiEdit(/lefthook.yml)",
      "Edit(/renovate.json)",
      "Write(/renovate.json)",
      "MultiEdit(/renovate.json)",
      "Edit(/tsconfig.base.json)",
      "Write(/tsconfig.base.json)",
      "MultiEdit(/tsconfig.base.json)",
      "Edit(/biome.json)",
      "Write(/biome.json)",
      "MultiEdit(/biome.json)",
      "Edit(/package.json)",
      "Write(/package.json)",
      "MultiEdit(/package.json)",
      "Edit(/pnpm-workspace.yaml)",
      "Write(/pnpm-workspace.yaml)",
      "MultiEdit(/pnpm-workspace.yaml)",
      "Edit(/commitlint.config.mjs)",
      "Write(/commitlint.config.mjs)",
      "MultiEdit(/commitlint.config.mjs)",
      "Edit(/.nvmrc)",
      "Write(/.nvmrc)",
      "MultiEdit(/.nvmrc)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin/:*)",
      "Bash(git clean -fdx:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs"
          }
        ]
      }
    ]
  }
}
