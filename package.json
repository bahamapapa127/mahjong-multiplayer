{
  "name": "mahjong-multiplayer",
  "version": "0.0.0",
  "private": true,
  "description": "Online multiplayer American Mahjong",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "turbo run typecheck lint test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^3.2.4",
    "lefthook": "^1.13.6",
    "tsx": "^4.22.3",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
