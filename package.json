{
  "name": "mahjong-multiplayer",
  "version": "0.0.0",
  "private": true,
  "description": "Online multiplayer American Mahjong",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "deps:check": "depcruise --validate apps packages",
    "check": "turbo run typecheck lint test && pnpm deps:check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "17.4.3",
    "lefthook": "2.1.14",
    "tsx": "4.23.13",
    "turbo": "2.11.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
